# Copy to .env and fill in. .env is git-ignored.

TZ=America/New_York

# LAN IP of the Docker host. Advertised to browsers as the WebRTC address.
HOST_IP=10.0.10.150

# Reolink NVR. Use a low-privilege account. If the password has URL-special
# characters (@ : / ? # & %), percent-encode them here.
NVR_HOST=10.0.10.134
NVR_USER=tablet
NVR_PASS=changeme

# Login for the go2rtc admin UI at http://HOST_IP:GO2RTC_API_PORT/
# (The kiosk page never needs it: Caddy talks to go2rtc over loopback.)
GO2RTC_ADMIN_USER=admin
GO2RTC_ADMIN_PASS=changeme

# Ports. These defaults avoid the old go2rtc stack (1984/8554/8555) and the
# old kiosk (8081), so both can run side by side during the switch-over.
SITE_PORT=8082
GO2RTC_API_PORT=1985
GO2RTC_WEBRTC_PORT=8565
